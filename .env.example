# Compose-level configuration for the whole stack.
# Copy to `.env` (`cp .env.example .env`) — docker compose reads it automatically.
# These values are injected into the service containers; the per-service `services/*/.env`
# files are excluded from the images and are only used when running a service on the host.

# --- Postgres -----------------------------------------------------------------
# Superuser for the container itself. The per-service roles are created by
# docker/postgres/init-databases.sh and all share SERVICE_DB_PASSWORD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SERVICE_DB_PASSWORD=password

# Published on 5433 because a native Postgres commonly already holds 5432 on the host.
# Inside the compose network services still connect to postgres:5432.
POSTGRES_HOST_PORT=5433

# --- Redis (auth) -------------------------------------------------------------
# Must be non-empty: envalid only applies REDIS_PASSWORD's devDefault outside production,
# so the prod target requires a real value.
REDIS_PASSWORD=redispassword

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_SECRET=randomlyGeneratedToken1234567890
REFRESH_TOKEN_SECRET=randomlyGeneratedTokenForRefresh1234567890

# --- MinIO (S3-compatible store for the post service) -------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=posts-bucket
S3_ACCESS_KEY_ID=posts-user
S3_SECRET_ACCESS=posts-user-password

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- API Gateway --------------------------------------------------------------
# Proves to the four services that a request arrived through the gateway. They only enforce it
# when NODE_ENV=production, so the dev target (`docker compose up`) leaves them directly
# callable on their own ports; the prod target admits gateway traffic only.
GATEWAY_SECRET=gatewaySharedSecret1234567890
