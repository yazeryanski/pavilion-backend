generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Newsletter {
  userId    String   @id            // recipient (a friend of the post authors)
  posts     Json     @default("[]") // ordered [{ postId, authorId }], newest first
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
