NODE_PORT = 3004
NODE_ENV = development

# Port 5433 is the Docker Postgres (see the root docker-compose.yml); 5432 is commonly a
# native install already running on the host.
DATABASE_URL = "postgresql://pavilion-newsletter-db-user:password@localhost:5433/pavilion-newsletter-db?schema=public"

# Proves a request arrived through the API gateway. Only enforced when NODE_ENV=production.
GATEWAY_SECRET = "dev-gateway-secret"

RABBITMQ_URL = "amqp://guest:guest@localhost:5672"

PROFILE_SERVICE_URL = "http://localhost:3002"
