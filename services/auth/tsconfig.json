{
	"compilerOptions": {
		"target": "ES6",
		"module": "CommonJS",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
			"@utils/*": ["utils/*"],
			"@routes/*": ["routes/*"],
			"@middlewares/*": ["middlewares/*"],
			"@controllers/*": ["controllers/*"],
			"@models/*": ["models/*"],
			"@connections/*": ["connections/*"]
		}
	},
	"include": ["src/**/*"]
}
