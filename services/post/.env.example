NODE_PORT = 3000
NODE_ENV = development

DATABASE_URL = "postgresql://user:password@localhost:5432/db?schema=public"

S3_ENDPOINT = "https://s3.amazonaws.com"
# Optional. Only set when the store is reached over a private network and the URLs handed to
# clients must use a different host (e.g. Docker: S3_ENDPOINT=http://minio:9000 but
# S3_PUBLIC_ENDPOINT=http://localhost:9000). Falls back to S3_ENDPOINT when empty.
S3_PUBLIC_ENDPOINT = ""
S3_REGION = "us-east-1"
S3_ACCESS_KEY_ID = "your-access-key-id"
S3_SECRET_ACCESS="your-secret-access-key"
S3_BUCKET_NAME = "your-bucket-name"
