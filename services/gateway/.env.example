NODE_PORT = 8080
NODE_ENV = development

# Proves to the downstream services that a request came through the gateway. They only enforce
# it when NODE_ENV=production, so the value below is fine for local work — but it must match
# what the other services see (the root .env supplies it to the whole stack under Docker).
GATEWAY_SECRET = "dev-gateway-secret"

# Upstreams. These are the host-side ports; under Docker compose overrides them with the
# in-network names (http://auth:3000 and friends).
AUTH_SERVICE_URL = "http://localhost:3000"
POST_SERVICE_URL = "http://localhost:3001"
PROFILE_SERVICE_URL = "http://localhost:3002"
NEWSLETTER_SERVICE_URL = "http://localhost:3004"
